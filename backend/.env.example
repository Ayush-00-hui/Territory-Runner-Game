# ==============================================================================
# Territory Runner Backend Configuration Template
# Copy to .env and customize for your target deployment environment.
# ==============================================================================

# Server Environment: 'development' | 'staging' | 'production' (Default: 'production')
# When ENV=production:
#   - AUTH_MODE=dev is strictly rejected (fails fast at startup)
#   - Query parameter tokens (?token=, ?user_id=) are rejected
#   - FIREBASE_PROJECT_ID is mandatory
# Dev auth strictly requires explicit ENV=development AND AUTH_MODE=dev.
ENV=development

# Listening HTTP / WebSocket Port (Default: 8080)
PORT=8080

# Authentication Mode: 'firebase' | 'dev' (Default: 'firebase')
# 'dev': Allows simulated users (?dev_user=<uid>) for offline/local testing. Strictly requires ENV=development.
# 'firebase': Verifies cryptographically signed Firebase ID JWTs
AUTH_MODE=dev

# Firebase Project ID (Required when AUTH_MODE=firebase)
FIREBASE_PROJECT_ID=

# Automated Schema Migrations on Startup: 'true' | 'false'
# When true, runs embedded SQL migrations guarded by PostgreSQL advisory locks
RUN_MIGRATIONS=true

# Database Credentials & URL
POSTGRES_USER=runner
POSTGRES_PASSWORD=runnerpass
DATABASE_URL=postgres://runner:runnerpass@localhost:5432/territory_runner?sslmode=disable

# CORS & WebSocket Allowed Origins (Comma-separated)
# In development, empty defaults to "*"
# In production, specify exact origin e.g. https://app.territoryrunner.com
ALLOWED_ORIGINS=

# Metrics Protection Token (Optional in dev, recommended in production)
# When set, GET /metrics requires 'Authorization: Bearer <METRICS_TOKEN>'
METRICS_TOKEN=

# Trusted Reverse Proxy CIDRs / IPs (Comma-separated, e.g. "127.0.0.1,10.0.0.0/8")
# X-Forwarded-For and X-Real-IP are ONLY trusted if the connecting remote IP is in TRUSTED_PROXIES.
TRUSTED_PROXIES=

# Google Gemini LLM API Key (For AI Tactical Commentary)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Operational Limits & Throttling
MAX_POINTS_PER_RUN=20000
MAX_RUN_DURATION_SECONDS=86400

