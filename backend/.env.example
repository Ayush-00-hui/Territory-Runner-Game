# Server environment: development | staging | production
ENV=development

# Server port
PORT=8085

# Authentication mode: dev | firebase
# NOTE: AUTH_MODE=dev is rejected if ENV=production
AUTH_MODE=dev

# PostgreSQL + PostGIS Connection URL
DATABASE_URL=postgres://runner:runnerpass@localhost:5432/territory_runner?sslmode=disable

# Gemini LLM Coach API Key (server-authoritative, populated in Phase 4)
GEMINI_API_KEY=
